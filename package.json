{
  "name": "voicelead",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/local-db.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/local-db.mjs --seed",
    "db:reset": "node -e \"require('fs').rmSync('.pglite',{recursive:true,force:true})\" && node scripts/local-db.mjs --seed",
    "db:studio": "node scripts/local-db.mjs prisma studio",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:remote-db": "next dev",
    "db:seed:remote": "prisma db seed",
    "vercel-build": "prisma migrate deploy && next build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.121",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "better-sqlite3@12.11.1": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
