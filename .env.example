# ─── Database ────────────────────────────────────────────────
# PostgreSQL. Locally, `npm run dev` starts an embedded Postgres (PGlite) on
# port 5433 and sets this for you. In production use your hosted Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# Connections per server instance (keep small on serverless).
DATABASE_POOL_MAX="5"

# ─── App ─────────────────────────────────────────────────────
# Public base URL, used to build intake links and QR codes.
APP_URL="http://localhost:3000"

# ─── Secrets (server-only, 32+ characters each) ──────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
IP_HASH_SECRET=""

# ─── Gemini (server-only, required from Phase 3) ─────────────
# Free key: https://aistudio.google.com/apikey  — never prefix with NEXT_PUBLIC_
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# "gemini" (default) or "mock" (rule-based stand-in for automated tests only).
AI_PROVIDER="gemini"

# ─── Demo seed ───────────────────────────────────────────────
# Password for the seeded demo accounts. Seed refuses to run in production.
# Set SHOW_DEMO_LOGIN="true" to show these accounts on the sign-in page (public demos).
SHOW_DEMO_LOGIN="false"
DEMO_OWNER_PASSWORD=""
